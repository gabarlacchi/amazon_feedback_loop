{
    "dataset": "amazon_e_commerce",
    "recbole_folder": "models_tmp_1",
    "frequent_costumers": true,
    "random_sample_users": false,
    "time_window": "2018-2022",
    "experiment_mode": "p-validation",
    "n_reps": 1,
    "use_cache": true,
    "recommender_model": {
        "model_name": "AdaptiveDiversity",
        "backbone": "BPR",
        "epochs": 50,
        "learning_rate": 0.001,
        "embedding_size": 64,
        "reg_weight": 0.0001
    },
    "user_strategy": {
        "model_name": "Custom choice model",
        "epochs": 1,
        "tau": null,
        "candidate_set": {
            "size": 50,
            "p_global": 0.40,
            "p_user": 0.40,
            "p_random": 0.20
        }
    },
    "k_items": 20,
    "cold_start_months": 12,
    "epochs": 24,
    "delta_training_epoch": 2,
    "use_all_data_from_start": false,
    "fixed_window_size": 12,
    "item_level": "category",
    "max_users": null
}