{
    "dataset": "amazon_sport_outdoor",
    "recbole_folder": "models_tmp_1",
    "frequent_costumers": true,
    "random_sample_users": false,
    "time_window": "2017-2023",
    "experiment_mode": "p-validation",
    "n_reps": 1,
    "use_cache": true,
    "recommender_model": {
        "model_name": "DeepFM",
        "epochs": 25,
        "learning_rate": 0.02,
        "embedding_size": 32,
        "mlp_hidden_size": [
            64,
            64
        ],
        "dropout_prob": 0.4
    },
    "user_strategy": {
        "model_name": "Custom choice model",
        "epochs": 1,
        "tau": null,
        "candidate_set": {
            "size": 50,
            "p_global": 0.40,
            "p_user": 0.40,
            "p_random": 0.20
        }
    },
    "k_items": 20,
    "cold_start_months": 6,
    "epochs": 24,
    "delta_training_epoch": 1,
    "use_all_data_from_start": true,
    "fixed_window_size": 6,
    "item_level": "category"
}

